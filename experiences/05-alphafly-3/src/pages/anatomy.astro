---
import Base from '../layouts/Base.astro';
const shoe='https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/5a90fe9f-c34c-4460-b856-a06d435a7256/AIR+ZOOM+ALPHAFLY+NEXT%25+3.png';
---
<Base title="Alphafly 3 Anatomy — Race Architecture">
<main class="anatomyPage" id="top">
<section class="anatomyHero"><div class="copy"><p class="eyebrow">Interactive anatomy / 04</p><h1 class="display">Four systems.<br/><em>One stride.</em></h1><p>Use the controls to isolate how Nike describes the upper, cushioning, forefoot Air units and carbon-fibre plate. The exploded illustration is conceptual; the actual shoe remains photographic.</p><a class="back" href="/">← Return to race</a></div><div class="shoeLab" id="shoeLab"><div class="layer labelUpper"><span>AtomKnit</span><i></i></div><div class="layer labelFoam"><span>ZoomX foam</span><i></i></div><div class="layer labelAir"><span>2× Air Zoom</span><i></i></div><div class="layer labelPlate"><span>Carbon Flyplate</span><i></i></div><img src={shoe} alt="Nike Alphafly 3 anatomy source photograph" transition:name="shoe-anatomy"/></div></section>
<section class="labControls section"><div class="sectionHead"><p class="eyebrow">System isolator</p><h2 class="display">Tap a layer.<br/><em>Change the read.</em></h2></div><div class="controlGrid" role="group" aria-label="Shoe system layers"><button class="active" data-layer="all" aria-pressed="true"><b>00</b><span>Complete system</span></button><button data-layer="upper" aria-pressed="false"><b>01</b><span>AtomKnit upper</span></button><button data-layer="foam" aria-pressed="false"><b>02</b><span>ZoomX foam</span></button><button data-layer="air" aria-pressed="false"><b>03</b><span>Air Zoom units</span></button><button data-layer="plate" aria-pressed="false"><b>04</b><span>Carbon Flyplate</span></button></div><div class="layerRead" id="layerRead"><p class="eyebrow">Complete system</p><h3>Containment → cushioning → energy return → propulsion.</h3><p>Alphafly 3 combines its four signature performance layers for road racing over half-marathon and marathon distances.</p></div></section>
<section class="energy section"><div><p class="eyebrow">Energy loop</p><h2 class="display">Load.<br/><em>Return.</em></h2><p>A visual metaphor for compression and rebound. Hold the pad to load the system, then release it.</p><button id="loadButton" class="loadButton">Hold to load</button></div><div class="energyRig" id="energyRig"><div class="ground"></div><img src={shoe} alt="Alphafly 3 energy-return visual"/><div class="forceArrow">↓</div></div></section>
<section class="final"><p class="eyebrow">Anatomy complete</p><h2 class="display">Back to<br/><em>race pace.</em></h2><a href="/">Return to main experience →</a></section>
</main>
<style>
.anatomyPage{background:#0a0a0a}.anatomyHero{min-height:100svh;padding:110px 6vw 55px;display:grid;grid-template-columns:.8fr 1.2fr;gap:4vw;align-items:center;background:#f26436;color:#090909}.anatomyHero .copy{position:relative;z-index:5}.anatomyHero .copy>p:last-of-type{max-width:580px;line-height:1.65}.anatomyHero .display em{color:white}.back{display:inline-block;margin-top:22px;font:500 8px DM Mono,monospace;text-transform:uppercase;border-bottom:1px solid #000;padding-bottom:6px}.shoeLab{position:relative;min-height:76vh;display:grid;place-items:center}.shoeLab img{width:min(96%,900px);mix-blend-mode:multiply;filter:contrast(1.06);transition:filter .35s,transform .5s cubic-bezier(.2,.8,.2,1)}.layer{position:absolute;z-index:5;display:flex;align-items:center;gap:8px;font:500 8px DM Mono,monospace;text-transform:uppercase;letter-spacing:.08em;transition:opacity .25s,transform .35s}.layer i{width:80px;height:1px;background:#111;display:block}.labelUpper{right:2%;top:23%}.labelFoam{left:2%;bottom:31%}.labelAir{right:1%;bottom:20%}.labelPlate{left:9%;top:46%}.shoeLab[data-focus=upper] img{filter:saturate(.3) contrast(.8) brightness(1.15);transform:translateY(-10px)}.shoeLab[data-focus=foam] img{filter:hue-rotate(25deg) saturate(1.2);transform:translateY(8px)}.shoeLab[data-focus=air] img{filter:saturate(1.35) contrast(1.15);transform:translateX(10px)}.shoeLab[data-focus=plate] img{filter:grayscale(.8) contrast(1.35);transform:rotate(-2deg)}.shoeLab[data-focus]:not([data-focus=all]) .layer{opacity:.17}.shoeLab[data-focus=upper] .labelUpper,.shoeLab[data-focus=foam] .labelFoam,.shoeLab[data-focus=air] .labelAir,.shoeLab[data-focus=plate] .labelPlate{opacity:1;transform:scale(1.15)}.labControls{background:#f4f4ef;color:#0a0a0a}.controlGrid{max-width:1400px;margin:auto;display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid #0002;border-left:1px solid #0002}.controlGrid button{min-height:170px;border:0;border-right:1px solid #0002;border-bottom:1px solid #0002;background:transparent;text-align:left;padding:20px;cursor:pointer}.controlGrid button b{display:block;font:400 36px Archivo Black,sans-serif}.controlGrid button span{font:500 8px DM Mono,monospace;text-transform:uppercase}.controlGrid button.active{background:#0a0a0a;color:var(--acid)}.layerRead{max-width:1400px;margin:30px auto 0;padding:36px;background:#e8e8e1}.layerRead h3{font:400 clamp(34px,4vw,62px)/.95 Archivo Black,sans-serif;text-transform:uppercase;letter-spacing:-.05em;max-width:900px}.layerRead>p:last-child{max-width:620px;color:#686863;line-height:1.6;font-size:12px}.energy{display:grid;grid-template-columns:.65fr 1.35fr;gap:6vw;align-items:center;background:#5d21ff}.energy>div:first-child>p:not(.eyebrow){max-width:560px;line-height:1.6;color:#c9bfff}.loadButton{margin-top:22px;background:var(--acid);border:0;padding:14px 18px;border-radius:999px;font:500 8px DM Mono,monospace;text-transform:uppercase;cursor:pointer}.energyRig{position:relative;min-height:650px;display:grid;place-items:center}.energyRig img{width:min(95%,820px);transition:transform .28s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(0 50px 35px #240d6d)}.energyRig.loaded img{transform:translateY(42px) scaleY(.94) rotate(-4deg)}.ground{position:absolute;left:8%;right:8%;bottom:15%;height:4px;background:var(--acid);box-shadow:0 0 35px var(--acid)}.forceArrow{position:absolute;top:15%;font:400 75px Archivo Black;color:var(--acid);transition:transform .28s,opacity .28s}.energyRig.loaded .forceArrow{transform:translateY(80px);opacity:1}.energyRig:not(.loaded) .forceArrow{opacity:.3}.final{background:#0a0a0a}@media(max-width:900px){.anatomyHero,.energy{grid-template-columns:1fr}.shoeLab{min-height:600px}.controlGrid{grid-template-columns:1fr 1fr}.controlGrid button:first-child{grid-column:1/-1}.energyRig{min-height:520px}}@media(max-width:600px){.anatomyHero{padding:86px 18px 50px}.anatomyHero .display{font-size:54px}.shoeLab{min-height:480px}.layer i{width:35px}.labelUpper{right:0}.labelFoam{left:0}.labelPlate{left:0}.controlGrid{grid-template-columns:1fr}.controlGrid button:first-child{grid-column:auto}.controlGrid button{min-height:105px}.energy{padding:88px 18px}.energyRig{min-height:430px}}
</style>
<script is:inline>
const copy={all:['Complete system','Containment → cushioning → energy return → propulsion.','Alphafly 3 combines its four signature performance layers for road racing over half-marathon and marathon distances.'],upper:['AtomKnit upper','Containment without shutting out airflow.','Nike says the re-tooled AtomKnit upper is designed for containment and breathability, using soft yarns for a comfortable fit.'],foam:['ZoomX foam','A continuous soft-and-responsive platform.','The ultralight ZoomX midsole is fully connected to the outsole for a smoother transition through the race.'],air:['Air Zoom units','Two forefoot chambers built for return.','Two Air Zoom units in the forefoot help store and return energy through each step.'],plate:['Carbon Flyplate','A tuned full-length propulsion structure.','Nike describes the slightly wider full-length carbon-fibre Flyplate as providing propulsion and stability.']};const lab=document.querySelector('#shoeLab'),read=document.querySelector('#layerRead');document.querySelectorAll('[data-layer]').forEach(btn=>btn.addEventListener('click',()=>{const k=btn.dataset.layer;lab.dataset.focus=k;document.querySelectorAll('[data-layer]').forEach(x=>{x.classList.toggle('active',x===btn);x.setAttribute('aria-pressed',String(x===btn))});read.innerHTML=`<p class="eyebrow">${copy[k][0]}</p><h3>${copy[k][1]}</h3><p>${copy[k][2]}</p>`}));const load=document.querySelector('#loadButton'),rig=document.querySelector('#energyRig');const set=v=>{rig.classList.toggle('loaded',v);load.textContent=v?'Loaded — release':'Hold to load'};load.addEventListener('pointerdown',()=>set(true));['pointerup','pointerleave','pointercancel'].forEach(e=>load.addEventListener(e,()=>set(false)));load.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter'){e.preventDefault();set(true)}});load.addEventListener('keyup',()=>set(false));
</script>
</Base>
