---
import Base from '../layouts/Base.astro';
const shoe='https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/7c939d1f-85c8-4cfc-ad28-b1aea980a958/AIR+ZOOM+ALPHAFLY+NEXT%25+3+GLAM.png';
const angles=[
'https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/7c939d1f-85c8-4cfc-ad28-b1aea980a958/AIR+ZOOM+ALPHAFLY+NEXT%25+3+GLAM.png',
'https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/9afea404-fa13-4c8e-8767-1bc6c9972266/AIR+ZOOM+ALPHAFLY+NEXT%25+3.png',
'https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/5a90fe9f-c34c-4460-b856-a06d435a7256/AIR+ZOOM+ALPHAFLY+NEXT%25+3.png',
'https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/ac239f66-cd66-44b1-a120-d4fcc6cef689/AIR+ZOOM+ALPHAFLY+NEXT%25+3+CM.png',
'https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:best/033c00fe-c615-40b8-8e82-fc6e09e14c36/AIR+ZOOM+ALPHAFLY+NEXT%25+3.png'
];
---
<Base>
<main>
<section class="hero" id="top"><div class="heroCopy"><p class="eyebrow">Nike Alphafly 3 · race-day system</p><h1 class="display">Built<br/>to <em>break</em><br/>pace.</h1><p class="heroLead">ZoomX foam, two forefoot Air Zoom units and a full-length carbon-fibre Flyplate — staged as a kinetic race interface.</p><div class="heroActions"><a class="darkBtn" href="#pace">Set your pace</a><a class="outlineBtn" href="/anatomy/">Open anatomy ↗</a></div></div><div class="heroVisual"><img src={shoe} class="heroShoe" alt="Nike Alphafly 3 Glam road racing shoe" fetchpriority="high"/><div class="heroMeta"><span>218 g*</span><span>8 mm drop</span><span>half / full marathon</span></div></div></section>

<section class="pace section" id="pace"><div class="sectionHead"><p class="eyebrow">01 · pace engine</p><h2 class="display">Choose the<br/><em>pressure.</em></h2><p>This is a visual pace simulator, not a performance prediction. Slide from controlled race rhythm to aggressive race effort and watch the motion field react.</p></div><div class="paceBoard"><div class="paceControl"><p class="eyebrow">Target pace / visual simulator</p><div class="paceRead"><b id="paceRead">4:15</b><span id="paceLabel">marathon rhythm</span></div><input id="paceRange" type="range" min="165" max="330" value="255" aria-label="Simulated running pace in seconds per kilometre"/><div class="paceMarks"><span>2:45 / km</span><span>5:30 / km</span></div></div><div class="paceVisual" id="paceVisual" style="--trail:.52"><div class="paceTrail"></div><img src={shoe} alt="Alphafly 3 pace visualization"/></div></div></section>

<section class="angles section"><div class="sectionHead"><p class="eyebrow">02 · inspect</p><h2 class="display">Every angle<br/><em>has a job.</em></h2><p>Cycle through real Nike product photography. Product form stays photographic; only the interaction and environment are designed here.</p></div><div class="angleShell"><div class="angleVisual" id="angleVisual"><img id="angleImage" src={angles[0]} alt="Nike Alphafly 3 product angle 1"/></div><div class="angleControls"><button id="prevAngle">← Previous</button><span class="angleCount" id="angleCount">01 / 05</span><button id="nextAngle">Next →</button></div></div></section>

<section class="race section" id="race"><div class="sectionHead"><p class="eyebrow">03 · race distance</p><h2 class="display">Half or full.<br/><em>Same intent.</em></h2><p>Nike positions Alphafly 3 as its pinnacle race-day shoe for half-marathons and marathons. Pick a distance and scrub the run.</p></div><div class="distanceTabs" role="group" aria-label="Race distance"><button class="active" data-distance="half" aria-pressed="true">Half marathon</button><button data-distance="full" aria-pressed="false">Marathon</button></div><div class="raceTrack"><div class="lane"></div><div class="runner" id="runner"><img src={shoe} alt="Alphafly runner marker"/></div><div class="raceStats"><div><span>Distance</span><b id="distanceValue">21.1 km</b></div><div><span>Progress</span><b id="raceProgress">12%</b></div><div><span>System</span><b>ZoomX + Air</b></div></div><input id="raceRange" type="range" min="0" max="100" value="12" aria-label="Race progress" style="position:absolute;left:8%;right:8%;top:18%;width:84%;accent-color:#f2ff00"/></div></section>

<section class="anatomyTease section"><div><p class="eyebrow">04 · engineered stack</p><h2 class="display">Open the<br/><em>layers.</em></h2><p>Explore AtomKnit, ZoomX, the twin forefoot Air Zoom units and the full-length carbon-fibre Flyplate in a separate anatomy view using Astro’s page transition system.</p><a class="darkBtn" href="/anatomy/">Launch anatomy →</a></div><img src={angles[2]} alt="Alphafly 3 technical angle" transition:name="shoe-anatomy"/></section>

<section class="final"><p class="eyebrow">Experience 05 / 10 · Astro + View Transitions</p><h2 class="display">The finish line<br/>starts <em>underfoot.</em></h2><a href="#top">Reset the race ↑</a></section>
</main>
<script is:inline define:vars={{angles}}>
let pace=255;const range=document.querySelector('#paceRange'),read=document.querySelector('#paceRead'),label=document.querySelector('#paceLabel'),visual=document.querySelector('#paceVisual');
function paceText(sec){const m=Math.floor(sec/60),s=String(sec%60).padStart(2,'0');return `${m}:${s}`}
range?.addEventListener('input',()=>{pace=+range.value;read.textContent=paceText(pace);const fast=1-(pace-165)/(330-165);visual.style.setProperty('--trail',(.22+fast*.73).toFixed(2));visual.classList.toggle('fast',fast>.62);label.textContent=fast>.68?'attack pace':fast>.42?'marathon rhythm':'controlled rhythm'});
let ai=0;const image=document.querySelector('#angleImage'),count=document.querySelector('#angleCount'),shell=document.querySelector('#angleVisual');function swap(dir){ai=(ai+dir+angles.length)%angles.length;shell.classList.add('swap');setTimeout(()=>{image.src=angles[ai];image.alt=`Nike Alphafly 3 product angle ${ai+1}`;count.textContent=`${String(ai+1).padStart(2,'0')} / ${String(angles.length).padStart(2,'0')}`;image.onload=()=>shell.classList.remove('swap');setTimeout(()=>shell.classList.remove('swap'),250)},120)}document.querySelector('#prevAngle')?.addEventListener('click',()=>swap(-1));document.querySelector('#nextAngle')?.addEventListener('click',()=>swap(1));
const raceRange=document.querySelector('#raceRange'),runner=document.querySelector('#runner'),progress=document.querySelector('#raceProgress'),distance=document.querySelector('#distanceValue');raceRange?.addEventListener('input',()=>{const p=+raceRange.value;runner.style.left=`${9+p*.72}%`;progress.textContent=`${p}%`});document.querySelectorAll('[data-distance]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-distance]').forEach(x=>{x.classList.toggle('active',x===btn);x.setAttribute('aria-pressed',String(x===btn))});distance.textContent=btn.dataset.distance==='full'?'42.2 km':'21.1 km'}));
</script>
</Base>
